{
  "name": "collection-time-prova",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": { "ADMIN_UID": "NaexH9CFKZVtTJFfCXb0mwrVfMy1" },
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "collection-time-dati", "database_id": "6822ba45-7a0b-49f9-ba71-589a186ce863" }
  ]
}
